# Python artifacts
__pycache__/
*.pyc
*.pyo
*.swp
*.swo
.Python

# Package / build
build/
dist/
*.egg-info/
pip-wheel-metadata/
Dockerfile

# Virtual environments and env files
# if on windows AI runs in WSL and IDE runs on Windows
# WSL uses python linux and windows uses windows linux
# they each need their own .venv
.venv*/
venv*/
env/
ENV/
.env

# Git metadata
.git
.gitignore

# IDE/editor directories
.idea/
.vscode/
.uv-cache/
.github/
.code/
.factory/
LICENSE
.pre-commit-config.yaml

# Logs and runtime files
*.log
*.sqlite3

# Documentation and tests not needed in final image
docs/
tests/
out/

# Markdown files (except app resources which may contain runtime-needed docs)
*.md
!app/resources/
!app/resources/*.md

# Temp files
*~
